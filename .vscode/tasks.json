{
  "version": "2.0.0",
  "tasks": [{
    "label": "Build Netflix project",
    "type": "process",
    "command": "powershell.exe",
    "args": ["-NoProfile", "-Command", "& 'C:/msys64/ucrt64/bin/g++.exe' -std=c++11 -Wall -Wextra -g @(Get-ChildItem -File -Filter '*.cpp' | ForEach-Object { $_.FullName }) -o netflix.exe; exit $LASTEXITCODE"],
    "options": {
      "cwd": "${workspaceFolder}",
      "env": {"PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"}
    },
    "problemMatcher": ["$gcc"],
    "group": {"kind": "build", "isDefault": true}
  }]
}
